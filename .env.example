# Copy to .env and adjust for your deployment. Never commit the real .env file.
SESSION_TTL_HOURS=72
MIN_IMAGES=8
RECOMMENDED_MIN_IMAGES=15
RECOMMENDED_MAX_IMAGES=30
MAX_IMAGES=40
MAX_FILE_SIZE_MB=15
MAX_SOURCE_DIMENSION=2000
CORS_ORIGINS=http://localhost:8000
ENVIRONMENT=development

# SMTP Email configuration (never hardcode real credentials in code)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@360rooms.local
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# OTP settings
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5

# -------------------------------------------------------------
# 24/7 Cloud Deployment Settings (Render / Turso / Cloudinary)
# -------------------------------------------------------------
# Turso Cloud SQLite (Free 9 GB, No Credit Card, https://turso.tech)
# If empty, automatically falls back to local SQLite at data/app.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cloudinary 360° Photo Storage (Free 25 GB CDN, No Credit Card, https://cloudinary.com)
# If empty, automatically falls back to local uploads/ directory
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

