# Copy to .env and adjust for your deployment. Never commit the real .env file.
SESSION_TTL_HOURS=72
MIN_IMAGES=8
RECOMMENDED_MIN_IMAGES=15
RECOMMENDED_MAX_IMAGES=30
MAX_IMAGES=40
MAX_FILE_SIZE_MB=15
MAX_SOURCE_DIMENSION=2000
CORS_ORIGINS=http://localhost:8000
ENVIRONMENT=development

# SMTP Email configuration (never hardcode real credentials in code)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@360rooms.local
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# OTP settings
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
